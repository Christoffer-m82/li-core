# Li OS Backend
# Safe example only.
# Never place real credentials in this file.

LI_OS_APP_NAME="Li OS Backend"
LI_OS_APP_VERSION="0.1.0"
LI_OS_ENVIRONMENT="development"
LI_OS_LOG_LEVEL="INFO"

LI_OS_DB_HOST="YOUR_SESSION_POOLER_HOST"
LI_OS_DB_PORT="5432"
LI_OS_DB_NAME="postgres"
LI_OS_DB_USER="li_backend_runtime.YOUR_PROJECT_REF"
LI_OS_DB_PASSWORD="YOUR_PRIVATE_RUNTIME_PASSWORD"
LI_OS_DB_SSLMODE="require"