# ============================================================
# Li OS Backend Environment Template
# ============================================================
#
# Copy this file locally to:
#
#   backend/.env
#
# when configuring a runtime environment.
#
# NEVER put real passwords, tokens, API keys, or database
# credentials in this example file.
#
# backend/.env is ignored by Git through the root .gitignore.
# ============================================================


# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

LI_OS_APP_NAME="Li OS Backend"

LI_OS_APP_VERSION="0.1.0"

LI_OS_ENVIRONMENT="development"

LI_OS_LOG_LEVEL="INFO"


# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
#
# This must eventually use a dedicated restricted Li OS
# runtime database account.
#
# DO NOT use the Supabase postgres administrator account.
#
# Example format only:
#
# postgresql://USERNAME:PASSWORD@HOST:5432/postgres?sslmode=require
#
# Replace the placeholder only in the private backend/.env
# file or the deployment platform's secrets manager.

LI_OS_DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/postgres?sslmode=require"
