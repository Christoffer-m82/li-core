# Li OS Backend
# Safe example only.
# Never place real credentials in this file.

LI_OS_APP_NAME="Li OS Backend"
LI_OS_APP_VERSION="0.1.0"
LI_OS_ENVIRONMENT="development"
LI_OS_LOG_LEVEL="INFO"

# Application authentication
LI_OS_API_TOKEN="YOUR_PRIVATE_API_TOKEN"
LI_OS_THEO_API_TOKEN="YOUR_PRIVATE_THEO_API_TOKEN"
LI_OS_OWNER_API_TOKEN="YOUR_PRIVATE_OWNER_API_TOKEN"

# Shared database connection
LI_OS_DB_HOST="YOUR_SESSION_POOLER_HOST"
LI_OS_DB_PORT="5432"
LI_OS_DB_NAME="postgres"
LI_OS_DB_SSLMODE="require"

# Normal Li runtime
LI_OS_DB_USER="li_backend_runtime.YOUR_PROJECT_REF"
LI_OS_DB_PASSWORD="YOUR_PRIVATE_RUNTIME_PASSWORD"

# Theo review runtime
LI_OS_THEO_DB_USER="li_theo_runtime.YOUR_PROJECT_REF"
LI_OS_THEO_DB_PASSWORD="YOUR_PRIVATE_THEO_RUNTIME_PASSWORD"

# Owner confirmation runtime
LI_OS_OWNER_DB_USER="li_owner_runtime.YOUR_PROJECT_REF"
LI_OS_OWNER_DB_PASSWORD="YOUR_PRIVATE_OWNER_RUNTIME_PASSWORD"

# Claude / Anthropic
LI_OS_ANTHROPIC_API_KEY="YOUR_PRIVATE_ANTHROPIC_API_KEY"
LI_OS_CLAUDE_MODEL="claude-sonnet-5"
LI_OS_CLAUDE_MAX_TOKENS="2048"