# Li OS Backend
# Safe example only.
# Never place real credentials in this file.

LI_OS_APP_NAME="Li OS Backend"
LI_OS_APP_VERSION="0.1.0"
LI_OS_ENVIRONMENT="development"
LI_OS_LOG_LEVEL="INFO"

# Application authentication
LI_OS_API_TOKEN="YOUR_PRIVATE_API_TOKEN"
LI_OS_THEO_API_TOKEN="YOUR_PRIVATE_THEO_API_TOKEN"
LI_OS_OWNER_API_TOKEN="YOUR_PRIVATE_OWNER_API_TOKEN"

# Shared database connection
LI_OS_DB_HOST="YOUR_SESSION_POOLER_HOST"
LI_OS_DB_PORT="5432"
LI_OS_DB_NAME="postgres"
LI_OS_DB_SSLMODE="require"

# Normal Li runtime
LI_OS_DB_USER="li_backend_runtime.YOUR_PROJECT_REF"
LI_OS_DB_PASSWORD="YOUR_PRIVATE_RUNTIME_PASSWORD"

# Theo review runtime
LI_OS_THEO_DB_USER="li_theo_runtime.YOUR_PROJECT_REF"
LI_OS_THEO_DB_PASSWORD="YOUR_PRIVATE_THEO_RUNTIME_PASSWORD"

# Owner confirmation runtime
LI_OS_OWNER_DB_USER="li_owner_runtime.YOUR_PROJECT_REF"
LI_OS_OWNER_DB_PASSWORD="YOUR_PRIVATE_OWNER_RUNTIME_PASSWORD"

# Claude / Anthropic
LI_OS_ANTHROPIC_API_KEY="YOUR_PRIVATE_ANTHROPIC_API_KEY"
LI_OS_CLAUDE_MODEL="claude-sonnet-5"
LI_OS_CLAUDE_MAX_TOKENS="2048"

# Optional Li-owned live web research. Create a key in the Brave Search API dashboard.
LI_OS_BRAVE_SEARCH_API_KEY="YOUR_PRIVATE_BRAVE_SEARCH_API_KEY"
LI_OS_BRAVE_SEARCH_TIMEOUT_SECONDS="10"

# Optional Li-owned Google Calendar OAuth integration. Use a secret manager in
# deployment and the narrow calendar.events scope; never commit real values.
LI_OS_GOOGLE_CALENDAR_CLIENT_ID="YOUR_PRIVATE_GOOGLE_OAUTH_CLIENT_ID"
LI_OS_GOOGLE_CALENDAR_CLIENT_SECRET="YOUR_PRIVATE_GOOGLE_OAUTH_CLIENT_SECRET"
LI_OS_GOOGLE_CALENDAR_REFRESH_TOKEN="YOUR_PRIVATE_GOOGLE_OAUTH_REFRESH_TOKEN"
LI_OS_GOOGLE_CALENDAR_ID="primary"
LI_OS_GOOGLE_CALENDAR_TIMEOUT_SECONDS="10"

# Optional Li-owned Gmail integration. Authorize both narrow scopes:
# gmail.readonly for search/read and gmail.compose for draft creation.
# Note: gmail.compose technically permits sending, but Li exposes no send action.
LI_OS_GOOGLE_GMAIL_CLIENT_ID="YOUR_PRIVATE_GOOGLE_OAUTH_CLIENT_ID"
LI_OS_GOOGLE_GMAIL_CLIENT_SECRET="YOUR_PRIVATE_GOOGLE_OAUTH_CLIENT_SECRET"
LI_OS_GOOGLE_GMAIL_REFRESH_TOKEN="YOUR_PRIVATE_GOOGLE_OAUTH_REFRESH_TOKEN"
LI_OS_GOOGLE_GMAIL_USER_ID="me"
LI_OS_GOOGLE_GMAIL_TIMEOUT_SECONDS="10"
